     property bool appIsReady: false
 
+    // F13 temporary debug helper (uncommitted): periodic dump of every offscreen texture (ShaderEffectSource)
+    // reachable from the window's item tree. Logs only when the (count, bytes) signature changes.
+    Timer {
+        id: f13LayerDump
+        interval: 10000; running: true; repeat: true
+        property string last: ""
+        function typeName(o) { return String(o).split("(")[0] }
+        function chain(it) { var s = []; var p = it; var n = 0; while (p && n < 6) { s.push(typeName(p) + (p.objectName ? "#" + p.objectName : "")); p = p.parent; n++ } return s.join(" < ") }
