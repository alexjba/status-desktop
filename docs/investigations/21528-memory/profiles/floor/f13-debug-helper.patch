+                    else if (src) { w = src.width * dpr; h = src.height * dpr }
+                    w = Math.ceil(w); h = Math.ceil(h)
+                    var bpp = (it.format === ShaderEffectSource.RGBA16F) ? 8 : 4
+                    var bytes = Math.round(w * h * bpp * (it.mipmap ? 1.34 : 1))
