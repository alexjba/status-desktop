+                               srcVis: src ? effVisible(src) : false, src: src ? chain(src) : "-", owner: chain(it.parent), mipmap: it.mipmap})
+                }
+                var ch = it.children
+                for (var i = 0; i < ch.length; i++) walk(ch[i])
+            }
+            walk(applicationWindow.contentItem)
+            var total = 0, totalVis = 0, nVis = 0, srcVisBytes = 0, nSrcVis = 0
+            for (var i = 0; i < rows.length; i++) { total += rows[i].bytes; if (rows[i].vis) { totalVis += rows[i].bytes; nVis++ }; if (rows[i].srcVis) { srcVisBytes += rows[i].bytes; nSrcVis++ } }
+            var sig = rows.length + "/" + total + "/" + layered
+            if (sig === last) return
