+            console.log("F13DUMP t=" + Date.now() + " items=" + items + " sources=" + rows.length + " visibleSources=" + nVis + " layeredItems=" + layered + " layeredVisible=" + layeredVisible + " bytes=" + total + " visibleBytes=" + totalVis + " srcVisibleSources=" + nSrcVis + " srcVisibleBytes=" + srcVisBytes + " dpr=" + dpr + " window=" + applicationWindow.width + "x" + applicationWindow.height)
+            for (var j = 0; j < rows.length; j++) { var r = rows[j]; console.log("F13ROW " + r.bytes + " " + r.w + "x" + r.h + (r.explicit ? "(textureSize)" : "") + " samples=" + r.samples + " live=" + r.live + " vis=" + r.vis + " srcVis=" + r.srcVis + " mip=" + r.mipmap + " src=" + r.src + " | owner=" + r.owner) }
+        }
+    }
